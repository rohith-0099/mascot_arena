# Full guide: docs/DEPLOYMENT.md
# ---- Supabase (required for photos; without these the arena runs in offline mode)
# Project Settings → API. The publishable (or legacy anon) key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SERVER ONLY. Secret (or legacy service_role) key. Never prefix with NEXT_PUBLIC_.
# On Vercel: Production environment only, marked Sensitive.
SUPABASE_SECRET_KEY=sb_secret_...
# SERVER ONLY. Hashes device/IP ids for rate limiting. Generate: openssl rand -hex 32
# Production refuses uploads if this is missing or shorter than 16 characters.
SUBMITTER_HASH_SALT=

# ---- Optional
# Show a countdown instead of local time (ISO 8601)
NEXT_PUBLIC_EVENT_END=2026-10-25T09:00:00+05:30
# Public URL encoded in the QR code (defaults to the current origin)
NEXT_PUBLIC_SITE_URL=https://realmhack.example
